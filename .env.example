BASE_URL=https://api.themoviedb.org/3
API_KEY=your_tmdb_api_key
ACCESS_TOKEN=your_tmdb_access_token

# Comma-separated frontend origins allowed to call this API (blocks direct open-proxy abuse).
# Add preview URLs when needed, e.g. https://moviesphere2660-git-main-youruser.vercel.app
ALLOWED_ORIGINS=https://moviesphere2660.vercel.app,http://localhost:5173

# Set to 1 only for local debugging without a browser Origin/Referer.
# SKIP_CLIENT_ACCESS_CHECK=1
